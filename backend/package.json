{
  "name": "newsynk-backend",
  "private": true,
  "engines": { "node": "22" },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test:rules": "firebase --config ../firebase.json --project demo-newsynk emulators:exec --only firestore \"node --test test/firestore.rules.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
